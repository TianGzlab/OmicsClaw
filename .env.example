# OmicsClaw — environment template
#
# Copy to `.env` in the repository root (or in the directory you run from)
# and fill in what you need. Nothing here is required except an LLM key.
#
# HOW IT IS READ
#   The process shell `omicsclaw/launch/` loads `<repo root>/.env` and
#   `<cwd>/.env` at start-up. A variable already exported in your shell
#   WINS over the file — the file never overwrites what you set by hand.
#   Everything below is also a command-line flag; the flag wins over the
#   variable. Precedence: flag > exported variable > .env file > default.
#
# THE THREE WAYS IN
#   oc cli        terminal REPL, or one exchange with --prompt-file
#   oc desktop    HTTP backend for the OmicsClaw-App client
#   oc channel    instant messaging (seven platforms, see section 11)
#
#   Deployment settings go before `--`; a surface's own flags may be
#   written on either side of it:
#     oc channel --workspace /data --channels telegram
#
# FILLING THIS IN WITHOUT AN EDITOR
#   `oc cli --configure` asks for a provider, a key, a model, an
#   endpoint and a workspace, plus Telegram / Feishu / the Desktop token
#   if you want them, and writes the answers into the `.env` the shell
#   above loads. It keeps your comments and any variable it did not ask
#   about, and leaves the previous version beside it as `.env.backup-…`.
#
# Generated against the rebuilt stack on 2026-09-20. If a variable is not
# in this file, the rebuilt stack does not read it — see the last section.


# ─────────────────────────────────────────────────────────────────────
# 1. LLM provider — the only part you must fill in
# ─────────────────────────────────────────────────────────────────────

# The key. `LLM_API_KEY` is read first, then `OMICSCLAW_API_KEY`.
LLM_API_KEY=

# Endpoint. Leave empty to use the preset's own base URL (below).
# Careful: a `LLM_BASE_URL` left over from another vendor silently
# hijacks the next provider you select.
LLM_BASE_URL=

# Which preset. Empty means it is inferred from the key you set.
#   anthropic  dashscope  deepseek  gemini  moonshot  nvidia  ollama
#   openai     openrouter siliconflow  volcengine  zhipu     custom
LLM_PROVIDER=

# Model id. `OMICSCLAW_MODEL` is read first, then `LLM_MODEL`.
# Empty means the preset's default (e.g. deepseek → deepseek-v4-flash).
LLM_MODEL=
#OMICSCLAW_MODEL=

# Per-vendor keys, used when you pick that preset instead of LLM_API_KEY.
# Only set the ones you actually use.
#ANTHROPIC_API_KEY=
#DASHSCOPE_API_KEY=
#DEEPSEEK_API_KEY=
#GOOGLE_API_KEY=
#MOONSHOT_API_KEY=
#NVIDIA_API_KEY=
#OPENAI_API_KEY=
#OPENROUTER_API_KEY=
#SILICONFLOW_API_KEY=
#VOLCENGINE_API_KEY=
#ZHIPU_API_KEY=

# Transport. Both spellings are read; the OMICSCLAW_ one wins.
#OMICSCLAW_LLM_TIMEOUT_SECONDS=          # or LLM_REQUEST_TIMEOUT_SECS
#OMICSCLAW_LLM_CONNECT_TIMEOUT_SECONDS=
#OMICSCLAW_LLM_MAX_RETRIES=              # or LLM_MAX_RETRIES
#OMICSCLAW_PROMPT_CACHE_BREAKPOINTS=     # vendor prompt-prefix caching


# ─────────────────────────────────────────────────────────────────────
# 2. Workspace and the turn
# ─────────────────────────────────────────────────────────────────────

# The directory the agent may read and write. Defaults to the working
# directory. This is the sandbox boundary for the file tools.
# The workspace is a trusted directory: its .mcp.json and .omicsclaw/ are
# taken as written, and so is its OMICSCLAW.md when the skills come from
# <workspace>/skills (OMICSCLAW_SKILLS_DIR unset, section 4).
#OMICSCLAW_WORKSPACE=

# Seconds one tool may run. Default 600 — a spatial-deconv run or a STAR
# alignment is minutes to hours, not the 60 s a generic harness assumes.
# `bash` derives its own ceiling from this; do not set a second number.
#OMICSCLAW_TOOL_TIMEOUT_S=600

#OMICSCLAW_MAX_TURNS=50                  # model calls per exchange
#OMICSCLAW_TURN_TIMEOUT_S=               # empty = no ceiling on a turn
#OMICSCLAW_APPROVAL_TIMEOUT_S=           # empty = wait for the human

# Files placed in front of the system prompt, `:`-separated or repeated.
# Empty means OMICSCLAW.md beside the skills directory — by default
# <workspace>/skills, so <workspace>/OMICSCLAW.md; set OMICSCLAW_SKILLS_DIR
# (section 4) to read the checkout's. Setting this replaces it.
# (Not to be confused with `oc cli --prompt-file`, which is one user
# message for a single execution.)
#OMICSCLAW_SYSTEM_PROMPT_FILES=

#OMICSCLAW_DIR=                          # state dir, default ~/.omicsclaw
#OMICSCLAW_CACHE_DIR=


# ─────────────────────────────────────────────────────────────────────
# 3. Context compaction and sessions
# ─────────────────────────────────────────────────────────────────────

# When to compact: none | warn | soft | full | emergency. Default warn.
#OMICSCLAW_COMPACT_AT=warn

#OMICSCLAW_SUMMARY_MODEL=                # empty = the main model
#OMICSCLAW_SUMMARY_TIMEOUT_S=90
#OMICSCLAW_MAX_SESSIONS=256
#OMICSCLAW_MAX_QUEUED_PER_SESSION=2
#OMICSCLAW_DELTA_RING_SIZE=2048          # replayable stream deltas


# ─────────────────────────────────────────────────────────────────────
# 4. Skills
# ─────────────────────────────────────────────────────────────────────

# The skill tree. OMICSCLAW.md, the agent's contract, is read from beside
# it. Setting this to an absolute path in the checkout's .env gives every
# start, from any directory, the checkout's skills and contract; a relative
# path is resolved against the directory the process starts in.
#OMICSCLAW_SKILLS_DIR=                   # empty = <workspace>/skills

# How much of the catalogue enters the system prompt.
#   full     one line per skill  (~7.5k tokens for 96 skills)
#   compact  a condensed index   (~550 tokens)
#   off      no catalogue, and `use_skill` is unmounted with it
#OMICSCLAW_SKILLS_INDEX=full

# Whether `use_skill` appends a note on which packages under the skill's
# "## Dependencies" the `python` that bash runs can import.
#   probe    append the note (default; never changes the prompt or tools)
#   off      return the skill exactly as before
#   install  as probe, and mount `install_skill_deps`, which asks before
#            installing declared packages into an overlay venv over that
#            `python` (the base environment is never changed). Packages
#            come from this machine's pip configuration, unchecked, as with
#            your own `pip install`. Not mounted while a sandbox runs;
#            in `oc desktop` it asks through an approval card like any
#            other tool.
#OMICSCLAW_SKILL_ENV=probe

# Where overlays are kept; empty = $XDG_CACHE_HOME/omicsclaw/envs,
# else ~/.cache/omicsclaw/envs. Any overlay directory may be deleted.
#OMICSCLAW_SKILL_ENV_DIR=
# Upper bound on one installation, dry run included, in seconds.
#OMICSCLAW_SKILL_ENV_INSTALL_TIMEOUT_S=1800


# ─────────────────────────────────────────────────────────────────────
# 5. Permission control
# ─────────────────────────────────────────────────────────────────────

# default | auto-approve | read-only | bypass-all
# `read-only` refuses anything not declaring read_only=True, which
# includes `bash`. `bypass-all` is for a throwaway container.
# Applies to all three surfaces, `oc channel` included.
#OMICSCLAW_PERMISSION_MODE=default

# The same setting for `oc cli` only, and what its `/auto` command
# writes. Used when OMICSCLAW_PERMISSION_MODE is not set; the
# --permission-mode flag still outranks both. `auto-approve` stops the
# questions about ordinary work; dangerous commands, explicit `ask`
# rules and changes to .omicsclaw/ or .env are still asked about.
#OMICSCLAW_CLI_PERMISSION_MODE=default

# Rule file. Empty = <workspace>/.omicsclaw/settings.json
#OMICSCLAW_PERMISSION_RULES=

# Audit trail: one JSON line per tool call. Empty = no log, and there is
# deliberately no default location — naming a path is the whole of
# switching it on. The tool's arguments are NOT recorded, only a SHA-256
# digest of them, so a line joins to the transcript without repeating a
# `bash` command line or a `write_file` body into a file that outlives
# the session.
#OMICSCLAW_AUDIT_LOG=


# ─────────────────────────────────────────────────────────────────────
# 6. Observability — OpenTelemetry tracing and metrics
# ─────────────────────────────────────────────────────────────────────

# Off unless this says otherwise. Accepts 1 / true / yes / on.
# With it off the agent constructs no recorder at all: the provider is
# not wrapped, no hook is mounted, and the object graph is what it was
# before `omicsclaw/observability/` existed.
#OTEL_ENABLED=false

# What a backend groups this process under.
#OTEL_SERVICE_NAME=omicsclaw

# noop | stdout | otlp
#   stdout — one JSON line per span on STDERR, plus a metric summary at
#            shutdown. Standard library only: nothing to install, and the
#            fastest way to see the trace tree of a run.
#   otlp   — needs `pip install 'omicsclaw[otel]'`. Without it this
#            degrades to noop with one warning, never a crash.
#OTEL_EXPORTER_TYPE=noop

# The BASE url, without /v1/traces — that suffix is appended for you.
# Langfuse:  https://cloud.langfuse.com/api/public/otel
# Local OTel collector / Jaeger:  http://localhost:4318
#OTEL_EXPORTER_OTLP_ENDPOINT=

# key=value pairs separated by commas. A value may itself contain "=".
# Langfuse:  Authorization=Basic <base64 of "pk-...:sk-...">,x-langfuse-ingestion-version=4
#            Without the ingestion-version header, traces show up in
#            Langfuse late.
#OTEL_EXPORTER_OTLP_HEADERS=

# ⚠️  Whether prompts, tool arguments and tool outputs are put INTO the
# spans — which means sending them to whatever OTEL_EXPORTER_OTLP_ENDPOINT
# points at. OFF, and the default is a safety property, not a preference:
# OmicsClaw prompts name cohorts, sequencing runs and patient samples,
# and the agent's first safety rule is that genetic data never leaves
# this machine. The reference harness this layer is modelled on always
# captures; this one does not.
#
# With it off you still get: span tree, turn structure, model name, token
# usage, durations, tool names, outcomes and every metric. You lose only
# the payloads. Turn it on when the collector runs on this same machine
# and you are debugging a prompt.
#OMICSCLAW_OTEL_CAPTURE_CONTENT=false


# ─────────────────────────────────────────────────────────────────────
# 7. Sandbox — run `bash` inside a container
# ─────────────────────────────────────────────────────────────────────

# off | docker | podman. Default off: `bash` runs on the host.
#OMICSCLAW_SANDBOX=off

# Required when the sandbox is on. The image must already be pulled —
# nothing is fetched at start-up.
#OMICSCLAW_SANDBOX_IMAGE=

#OMICSCLAW_SANDBOX_NETWORK=none          # `none` is the point of this
#OMICSCLAW_SANDBOX_RUNTIME=docker
#OMICSCLAW_SANDBOX_REQUIRED=false        # true = refuse to start without it
#OMICSCLAW_SANDBOX_MEMORY=auto          # auto = 80% of MemTotal; empty = no cap
#OMICSCLAW_SANDBOX_CPUS=                 # empty = every CPU
#OMICSCLAW_SANDBOX_GPUS=                 # e.g. all; empty = the container sees no GPU
#OMICSCLAW_SANDBOX_USER=
#OMICSCLAW_SANDBOX_MOUNTS=
#OMICSCLAW_SANDBOX_BOOTSTRAP=
#OMICSCLAW_SANDBOX_BOOTSTRAP_TIMEOUT_S=600

# Container resources, shared by `bash` and every run_skill trial.
#OMICSCLAW_SANDBOX_TMPFS_SIZE=64g        # /tmp
#OMICSCLAW_SANDBOX_SHM_SIZE=128g         # /dev/shm; empty = Docker's 64 MiB
#OMICSCLAW_SANDBOX_PIDS_LIMIT=65536      # processes and threads
#OMICSCLAW_SANDBOX_NOFILE=65536          # open files; 0 = the image's limit

# The repository's omicsclaw/ and skills/ are mounted read-only at their
# host paths so skill scripts run in the container; `.env` and
# `.omicsclaw/` in the workspace are hidden from it. Set true when the
# image already contains the code.
#OMICSCLAW_SANDBOX_CODE_IN_IMAGE=false

# Let `bash` run without per-command approval — but only while the
# container is up with no network. Off outside the sandbox, always.
#OMICSCLAW_SANDBOX_AUTO_APPROVE=false


# ─────────────────────────────────────────────────────────────────────
# 8. MCP servers
# ─────────────────────────────────────────────────────────────────────

#OMICSCLAW_MCP_CONFIG=                   # empty = <workspace>/.mcp.json
#OMICSCLAW_MCP_CONNECT_TIMEOUT_S=30

# Note: `${VAR}` inside .mcp.json is still expanded from the live process
# environment rather than from this file's resolved mapping. Export those
# variables if a server needs them.


# ─────────────────────────────────────────────────────────────────────
# 9. Memory and planning
# ─────────────────────────────────────────────────────────────────────

#OMICSCLAW_MEMORY=true
#OMICSCLAW_PLANNING=true
#OMICSCLAW_PLANNING_GATE_TURNS=8

# Ensemble: the `run_skill` tool (parallel, scored skill trials).
# Unset = mounted when the start-up self-check passes and the host has
# memory left after the reserve below, warned about otherwise; true =
# refuse to start if either fails; false = off.
#OMICSCLAW_ENSEMBLE=
# Interpreter for trials and scoring; needs scanpy, igraph and the skill's
# own dependencies. Empty = this process's python (python in the sandbox).
#OMICSCLAW_ENSEMBLE_PYTHON=
#OMICSCLAW_ENSEMBLE_GPUS=                # empty = detect; none; or 0,1,2
#OMICSCLAW_ENSEMBLE_SLOTS_PER_GPU=1
#OMICSCLAW_ENSEMBLE_MEMORY_GB=0          # 0 = all but tmpfs, shm and the reserve
#OMICSCLAW_ENSEMBLE_RESERVED_GB=64       # kept for bash and the system
#OMICSCLAW_ENSEMBLE_CPUS=0               # 0 = every CPU
#OMICSCLAW_ENSEMBLE_MEMORY_GB_CAP=0      # 0 = each method's own limit
#OMICSCLAW_ENSEMBLE_MAX_TRIAL_S=7200
#OMICSCLAW_ENSEMBLE_MAX_QUEUE_S=7200
#OMICSCLAW_ENSEMBLE_KEEP_ALL=false       # true = keep every trial's figures and h5ad
# Tuning: which tools (all = run_skill, inspect_trials, select_result,
# optimize_params; free = the first three; tuning = optimize_params only),
# the per-session run budget (empty, a number, or leiden:60,spagcn:12),
# the model optimize_params asks (empty = the agent's), and the inputs allowed.
#OMICSCLAW_ENSEMBLE_TOOLS=all
#OMICSCLAW_ENSEMBLE_RUN_BUDGET=
#OMICSCLAW_ENSEMBLE_TUNING_MODEL=
#OMICSCLAW_ENSEMBLE_TUNING_PROVIDER=
#OMICSCLAW_ENSEMBLE_TUNING_TISSUE=true   # false = drop the tissue argument
#OMICSCLAW_ENSEMBLE_TUNING_IMAGES=false  # not supported; true refuses start-up
#OMICSCLAW_ENSEMBLE_TUNING_BUDGET=12     # new parameter sets per method
#OMICSCLAW_ENSEMBLE_TUNING_MAX_S=43200
#OMICSCLAW_ENSEMBLE_OBS_ALLOWLIST=       # e.g. batch; empty = any obs columns
#OMICSCLAW_ENSEMBLE_SEED=0               # seed of every trial process; none = unseeded


# ─────────────────────────────────────────────────────────────────────
# 10. Desktop surface  (`oc desktop`)
# ─────────────────────────────────────────────────────────────────────

# Bearer token for the HTTP backend. REQUIRED if you bind anywhere other
# than loopback: `oc desktop --host 0.0.0.0` with this empty is refused,
# because an empty token means "allow everyone" and this surface carries
# a full agent with a `bash` tool. Optional on a loopback bind, but set it
# on a server other people can log in to: they can reach 127.0.0.1 too.
# It may live in this file, which `oc desktop` reads at start (a variable
# already exported wins); `chmod 600 .env`. That keeps it out of the start
# command and the process list. The desktop app's connection profile keeps
# its copy in plain text.
#OMICSCLAW_REMOTE_AUTH_TOKEN=

#OMICSCLAW_DESKTOP_LAUNCH_ID=            # echoed in /health, for clients

# Host, port and abandon grace are surface flags, not variables:
#   oc desktop --host 127.0.0.1 --port 8765
# --abandon-grace <seconds> (1-86400, default 30) is how long an exchange
# keeps running once the server has noticed that nobody is watching it; a
# client that reconnects within it picks the reply up where it broke off.
# For a server the desktop app reaches over SSH
# (docs/engineering/remote-execution.mdx); OMICSCLAW_SKILLS_DIR is needed
# when <dir> is not the checkout:
#   OMICSCLAW_SKILLS_DIR=<checkout>/skills \
#   oc desktop --workspace <dir> --delta-ring-size 65536 -- --host 127.0.0.1 --port 8765 --abandon-grace 600


# ─────────────────────────────────────────────────────────────────────
# 11. Channel surface  (`oc channel --channels telegram,slack`)
# ─────────────────────────────────────────────────────────────────────
#
# Seven adapters can start: Telegram, Feishu, Slack, Discord, DingTalk,
# QQ and Email. `oc channel --list` prints the table.
#
# Every one of them REQUIRES an owner allowlist and refuses to start
# without it. Run one platform per process unless you specifically want
# them to share a session registry: `--channels` is an explicit list, and
# one mistyped credential stops every channel named on it from starting.

# --- Telegram ---
#TELEGRAM_BOT_TOKEN=
# At least one of the next two is required; without them the adapter
# refuses to start rather than answering strangers.
#TELEGRAM_CHAT_ID=
#TELEGRAM_ALLOWED_SENDERS=
#TELEGRAM_ACCOUNT_NAMESPACE=

# --- Feishu / Lark ---
#FEISHU_APP_ID=
#FEISHU_APP_SECRET=
# Required. Owner open_id values, comma-separated. Feishu ingress admits
# nobody else and refuses to start without this.
#FEISHU_ALLOWED_SENDERS=
# Required. This bot's own open_id. Feishu ingress refuses to start
# without it, because an @-mention cannot otherwise be attributed to this
# bot.
#FEISHU_BOT_OPEN_ID=
#FEISHU_RATE_LIMIT_PER_HOUR=
#FEISHU_MAX_ATTACHMENTS=
#FEISHU_MAX_INBOUND_FILE_MB=
#FEISHU_MAX_INBOUND_IMAGE_MB=
#FEISHU_THINKING_THRESHOLD_MS=
#FEISHU_BRIDGE_DEBUG=

# --- Slack (Socket Mode; no public IP needed) ---
#SLACK_BOT_TOKEN=                        # xoxb-...
#SLACK_APP_TOKEN=                        # xapp-..., for Socket Mode
# Required. Owner user ids (U...), comma-separated.
#SLACK_ALLOWED_SENDERS=
#SLACK_RATE_LIMIT_PER_HOUR=
#SLACK_PROXY=

# --- Discord ---
#DISCORD_BOT_TOKEN=
# Required. Owner user ids (snowflakes), comma-separated.
#DISCORD_ALLOWED_SENDERS=
#DISCORD_RATE_LIMIT_PER_HOUR=
#DISCORD_PROXY=

# --- DingTalk (Stream Mode; no public IP needed) ---
#DINGTALK_CLIENT_ID=                     # robot App Key
#DINGTALK_CLIENT_SECRET=
# Required. Owner staff ids, comma-separated.
#DINGTALK_ALLOWED_SENDERS=
#DINGTALK_RATE_LIMIT_PER_HOUR=

# --- QQ ---
#QQ_APP_ID=
#QQ_APP_SECRET=
# Required. Owner openid values, comma-separated.
#QQ_ALLOWED_SENDERS=
#QQ_RATE_LIMIT_PER_HOUR=

# --- Email (IMAP polling in, SMTP out) ---
#EMAIL_IMAP_HOST=
#EMAIL_IMAP_PORT=993
#EMAIL_IMAP_USERNAME=
#EMAIL_IMAP_PASSWORD=
#EMAIL_IMAP_MAILBOX=INBOX
#EMAIL_IMAP_USE_SSL=1
#EMAIL_SMTP_HOST=
#EMAIL_SMTP_PORT=587
#EMAIL_SMTP_USERNAME=
#EMAIL_SMTP_PASSWORD=
#EMAIL_SMTP_STARTTLS=1                   # 0 = implicit SSL, port 465
#EMAIL_FROM_ADDRESS=                     # defaults to EMAIL_SMTP_USERNAME
#EMAIL_POLL_INTERVAL=30
#EMAIL_MARK_SEEN=1
# Required. Owner addresses, comma-separated.
#EMAIL_ALLOWED_SENDERS=
#EMAIL_RATE_LIMIT_PER_HOUR=


# ─────────────────────────────────────────────────────────────────────
# 12. No longer read by the rebuilt stack
# ─────────────────────────────────────────────────────────────────────
#
# These were read by `omicsclaw/surfaces/`, which the three surfaces
# above replaced. They are listed so an old `.env` can be pruned with
# confidence rather than kept "just in case". Setting them does nothing.
#
#   Cross-platform fallbacks — each platform now names its own senders
#   variable, and a global rate limit has no owner:
#     ALLOWED_SENDERS  RATE_LIMIT_PER_HOUR  GLOBAL_RATE_LIMIT
#
#   Legacy memory service — replaced by the rebuilt omicsclaw/memory/,
#   which is switched with OMICSCLAW_MEMORY and needs no server:
#     OMICSCLAW_MEMORY_ENABLED  OMICSCLAW_MEMORY_HOST
#     OMICSCLAW_MEMORY_PORT     OMICSCLAW_MEMORY_DB_URL
#     OMICSCLAW_MEMORY_API_TOKEN
#
#   Legacy loop and runner knobs — the engine and the context budget
#   own these now (OMICSCLAW_MAX_TURNS, OMICSCLAW_COMPACT_AT):
#     OMICSCLAW_MAX_TOOL_ITERATIONS  OMICSCLAW_MAX_HISTORY
#     OMICSCLAW_MAX_HISTORY_CHARS    OMICSCLAW_OUTPUT_DIR
#     OMICSCLAW_DATA_DIRS
#
#   Legacy multi-role model selection — the rebuilt stack runs one
#   provider per deployment (LLM_PROVIDER / LLM_MODEL):
#     OC_LLM_PROVIDER  OC_LLM_MODEL  OC_CODING_PROVIDER  OC_CODING_MODEL
#     OC_PLANNER_PROVIDER  OC_PLANNER_MODEL
#     OC_REVIEWER_PROVIDER  OC_REVIEWER_MODEL
#     OC_NOTEBOOK_TIMEOUT  OC_RECURSION_LIMIT
#
#   Old skill-runner environment switches — the adaptive per-skill
#   environment provisioning they controlled was removed with the
#   runner, and nothing reads them now. OMICSCLAW_SKILL_ENV (section 4)
#   replaces them:
#     OMICSCLAW_ADAPTIVE_ENV  OMICSCLAW_SKIP_ADAPTIVE_ENV
#     OMICSCLAW_ENV_DIR       OMICSCLAW_RUN_PYTHON
#
#   Other:
#     LLM_AUTH_MODE      CCPROXY_PORT      TAVILY_API_KEY
#     OMICSCLAW_APP_HOST OMICSCLAW_APP_PORT
#       (host and port are `oc desktop --host/--port` flags now)
